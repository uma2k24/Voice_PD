# Copy to .env for local development. Existing environment variables take priority.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PD_MODEL_DIR=models_conversation
# Optional shared backend token for clients outside localhost.
PD_API_TOKEN=
# Comma-separated permitted browser origins; no wildcard.
PD_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
